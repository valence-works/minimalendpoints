<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Minimal</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MinimalEndpoints/MinimalEndpoints.csproj" />
    <ProjectReference Include="../../src/MinimalEndpoints.OpenApi/MinimalEndpoints.OpenApi.csproj" />

    <!--
      Analyzers do not flow through a ProjectReference chain, only through a package's analyzers/
      folder. A consumer installing the NuGet package gets the generator automatically; inside this
      repository the samples reference it directly.
    -->
    <ProjectReference Include="../../src/MinimalEndpoints.Generator/MinimalEndpoints.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
